# Opcional. Quando ausente, o servidor mantém salas somente em memória.
# Em produção, aponte para um volume persistente montado (ADR-011).
ROOM_STORAGE_FILE=/data/rooms.json

# development | test | production. Em produção, CORS_ORIGINS e METRICS_TOKEN
# passam a ser obrigatórios (o servidor falha cedo se estiverem ausentes).
NODE_ENV=development

PORT=3001
HOST=0.0.0.0

# Obrigatório em produção: lista de origens permitidas, separadas por vírgula.
# CORS_ORIGINS=https://seu-dominio.example.com

# Obrigatório em produção: bearer token pra proteger /metrics (min. 16 chars).
# Gere com: node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
# METRICS_TOKEN=

# Opcional: espera do "Jogar agora" antes de completar a mesa com bots (0 a 120000 ms).
# QUICKPLAY_WAIT_MS=10000

# Opcional: limite por vez de uma pessoa conectada (1000 a 600000 ms; 0 desliga).
# Ao estourar, um bot joga só aquela vez; depois de 2 estouros seguidos ele joga
# até a pessoa agir.
# TURN_LIMIT_MS=30000

# Opcional: quanto esperar por quem perdeu a conexão antes de um bot jogar por
# ela até voltar (1000 a 600000 ms; 0 desliga).
# DISCONNECT_GRACE_MS=20000

# Habilita rotas de fixture E2E. Nunca funciona quando NODE_ENV=production,
# mesmo que a flag esteja "1".
# KABEMJUNTO_E2E_FIXTURE=0
