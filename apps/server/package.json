{
  "name": "@kabemjunto/server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend autoritativo do Kabemjunto (Fastify + Socket.IO + TypeScript).",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "echo 'lint: server (ESLint config em S0-2)' && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^10.1.3",
    "@kabemjunto/shared": "0.1.0",
    "fastify": "^5.12.0",
    "pino-pretty": "^11.0.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.6.0",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
