# PostHog Cloud (telemetria em prod)
# Sprint 5 — B17
#
# 1. Criar conta em https://posthog.com (free tier: 1M eventos/mês)
# 2. Criar projeto "Kabemjunto"
# 3. Project Settings → API Keys → copiar "Project token"
# 4. Colar abaixo (formato: phc_xxxxxxxxxxxx)
VITE_POSTHOG_API_KEY=phc_your_project_token_here

# Host do PostHog (opcional)
# - US Cloud: https://us.i.posthog.com (default)
# - EU Cloud: https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Backend Socket.IO
VITE_SOCKET_URL=http://127.0.0.1:3001
