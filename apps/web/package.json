{
  "name": "@kabemjunto/web",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend PWA do Kabemjunto (Vite + React + TypeScript).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "echo 'lint: web (ESLint config em S0-2)' && exit 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kabemjunto/shared": "0.1.0",
    "@tanstack/react-query": "^5.40.0",
    "framer-motion": "^11.2.0",
    "qrcode-generator": "2.0.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "socket.io-client": "^4.7.5",
    "three": "0.186.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^1.6.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
