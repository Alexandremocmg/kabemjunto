{
  "name": "kabemjunto",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "Kabemjunto — o jogo de cartas que te denuncia. 2-10 jogadores, 8-15 min por partida.",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:server": "npm --prefix apps/server run dev",
    "dev:web": "npm --prefix apps/web run dev -- --host --port 5173",
    "build:shared": "npm --prefix packages/shared run build",
    "build:server": "npm --prefix apps/server run build",
    "build": "npm run build:shared && npm run build:server && npm --prefix apps/web run build",
    "preview": "npm --prefix apps/web run preview",
    "typecheck": "npm run build:shared && npm --prefix apps/server run typecheck && npm --prefix apps/web run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css,yml,yaml}\"",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fast-check": "^3.23.2",
    "jsdom": "^24.1.3",
    "prettier": "^3.9.6",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.2.11",
    "vitest": "^4.1.10"
  }
}
